define endian=big;

define alignment=4;

define space default type=ram_space size=4 wordsize=4 default;

define register offset=0x40000 size=4 [
	r0l r0h r1l r1h r2l r2h r3l r3h
	r4l r4h r5l r5h r6l r6h r7l r7h r8l r8h
];

define register offset=0x40008 size=4 [ cpuinfo ];
define register offset=0x40010 size=4 [ trace_addr ];

define token opword (32)
	op = (31..24)
	rt = (23..18)
	rs = (17..12)
	rd = (11..6)
	funct = (5..0)
	op2 = (31..26)
;

define token branch (32)
	op = (31..24)
	cc = (23..18)
	off = (17..0)
;

attach variables [ r0l r0h r1l r1h r2l r2h r3l r3h
	r4l r4h r5l r5h r6l r6h r7l r7h ];

:dep.c fixture-a is op=0x3a { export *[ram]:4; }
:dep.c fixture-b is op=0x3b { export *[ram]:4; }
